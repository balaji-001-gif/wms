{
  "name": "Inbound Shipment",
  "module": "warehouse_management",
  "doctype": "DocType",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "format:WMS-INB-.YYYY.-.#####",
  "description": "Gate-to-put-away inbound flow (GRN → Inspection → Putaway). Maps to Amazon FC receive, Flipkart GRN, Zepto quick-receive.",
  "fields": [
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "label": "Supplier",
      "options": "Supplier",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "purchase_order",
      "fieldtype": "Link",
      "label": "Purchase Order",
      "options": "Purchase Order"
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Receiving Warehouse",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "receiving_zone",
      "fieldtype": "Link",
      "label": "Receiving Zone",
      "options": "Warehouse Zone"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nReceived\nInspecting\nPutaway Pending\nCompleted\nRejected",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "vehicle_number",
      "fieldtype": "Data",
      "label": "Vehicle / AWB Number"
    },
    {
      "fieldname": "expected_arrival",
      "fieldtype": "Datetime",
      "label": "Expected Arrival"
    },
    {
      "fieldname": "actual_arrival",
      "fieldtype": "Datetime",
      "label": "Actual Arrival"
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Items"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Inbound Shipment Item"
    },
    {
      "fieldname": "section_break_qc",
      "fieldtype": "Section Break",
      "label": "QC & Inspection"
    },
    {
      "fieldname": "qc_required",
      "fieldtype": "Check",
      "label": "QC Required",
      "default": 0
    },
    {
      "fieldname": "qc_done_by",
      "fieldtype": "Link",
      "label": "QC Done By",
      "options": "User",
      "depends_on": "eval:doc.qc_required"
    },
    {
      "fieldname": "qc_remarks",
      "fieldtype": "Small Text",
      "label": "QC Remarks"
    },
    {
      "fieldname": "section_break_putaway",
      "fieldtype": "Section Break",
      "label": "Putaway"
    },
    {
      "fieldname": "putaway_strategy",
      "fieldtype": "Select",
      "label": "Putaway Strategy",
      "options": "Manual\nAuto - Zone Priority\nAuto - FEFO\nAuto - ABC Classification"
    },
    {
      "fieldname": "putaway_details",
      "fieldtype": "Table",
      "label": "Putaway Plan",
      "options": "Inbound Putaway Row"
    },
    {
      "fieldname": "linked_purchase_receipt",
      "fieldtype": "Link",
      "label": "Linked Purchase Receipt",
      "options": "Purchase Receipt",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Inbound Shipment",
      "read_only": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {"role": "WMS Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "delete": 1},
    {"role": "WMS Receiver", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1, "cancel": 1}
  ],
  "title_field": "name",
  "search_fields": "supplier,purchase_order,status"
}
