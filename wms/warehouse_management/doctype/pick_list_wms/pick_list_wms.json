{
  "name": "Pick List WMS",
  "module": "warehouse_management",
  "doctype": "DocType",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "WMS-PICK-.#####",
  "description": "Wave/batch/single picking list – models Amazon pick-cart, Flipkart wave pick, Zepto 10-min quick-pick",
  "fields": [
    {
      "fieldname": "pick_type",
      "fieldtype": "Select",
      "label": "Pick Type",
      "options": "Single Order\nBatch Pick\nWave Pick\nCluster Pick",
      "reqd": 1,
      "default": "Single Order",
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Warehouse",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "picker",
      "fieldtype": "Link",
      "label": "Assigned Picker",
      "options": "User"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nAssigned\nIn Progress\nPicked\nShort Pick\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority",
      "options": "Normal\nHigh\nUrgent",
      "default": "Normal",
      "in_list_view": 1
    },
    {
      "fieldname": "sla_deadline",
      "fieldtype": "Datetime",
      "label": "SLA Deadline"
    },
    {
      "fieldname": "linked_delivery_orders",
      "fieldtype": "Small Text",
      "label": "Linked Delivery Orders (JSON)",
      "hidden": 1
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Pick Lines"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Pick List WMS Item"
    },
    {
      "fieldname": "section_break_summary",
      "fieldtype": "Section Break",
      "label": "Summary"
    },
    {
      "fieldname": "total_lines",
      "fieldtype": "Int",
      "label": "Total Lines",
      "read_only": 1
    },
    {
      "fieldname": "picked_lines",
      "fieldtype": "Int",
      "label": "Picked Lines",
      "read_only": 1
    },
    {
      "fieldname": "short_lines",
      "fieldtype": "Int",
      "label": "Short Lines",
      "read_only": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "start_time",
      "fieldtype": "Datetime",
      "label": "Pick Start Time",
      "read_only": 1
    },
    {
      "fieldname": "end_time",
      "fieldtype": "Datetime",
      "label": "Pick End Time",
      "read_only": 1
    },
    {
      "fieldname": "pick_duration_mins",
      "fieldtype": "Float",
      "label": "Pick Duration (mins)",
      "read_only": 1
    },
    {
      "fieldname": "linked_delivery_note",
      "fieldtype": "Link",
      "label": "Linked Delivery Note",
      "options": "Delivery Note",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Pick List WMS",
      "read_only": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {"role": "WMS Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "delete": 1},
    {"role": "WMS Picker", "read": 1, "write": 1, "submit": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1, "cancel": 1}
  ],
  "title_field": "name",
  "search_fields": "picker,status,pick_type"
}
