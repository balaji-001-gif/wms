{
  "name": "Outbound Shipment",
  "module": "warehouse_management",
  "doctype": "DocType",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "WMS-OUT-.#####",
  "description": "End-to-end outbound order: Pick → Pack → Manifest → Dispatch. Models Amazon Ship, Flipkart dispatch, Zepto last-mile.",
  "fields": [
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sales_order",
      "fieldtype": "Link",
      "label": "Sales Order",
      "options": "Sales Order"
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Dispatch Warehouse",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPick Pending\nPacking\nManifested\nDispatched\nDelivered\nRTO\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "channel",
      "fieldtype": "Select",
      "label": "Sales Channel",
      "options": "\nWebsite\nAmazon\nFlipkart\nMeesho\nB2B Direct\nZepto\nBlinkit\nSwiggy Instamart\nOther Marketplace",
      "in_list_view": 1
    },
    {
      "fieldname": "carrier",
      "fieldtype": "Link",
      "label": "Carrier / 3PL",
      "options": "Supplier"
    },
    {
      "fieldname": "tracking_number",
      "fieldtype": "Data",
      "label": "AWB / Tracking Number"
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Items"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Outbound Shipment Item"
    },
    {
      "fieldname": "section_break_pack",
      "fieldtype": "Section Break",
      "label": "Packing"
    },
    {
      "fieldname": "pick_list_wms",
      "fieldtype": "Link",
      "label": "Pick List",
      "options": "Pick List WMS"
    },
    {
      "fieldname": "packing_station",
      "fieldtype": "Link",
      "label": "Packing Station",
      "options": "Packing Station"
    },
    {
      "fieldname": "packed_by",
      "fieldtype": "Link",
      "label": "Packed By",
      "options": "User"
    },
    {
      "fieldname": "packed_on",
      "fieldtype": "Datetime",
      "label": "Packed On",
      "read_only": 1
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "total_packages",
      "fieldtype": "Int",
      "label": "Total Packages"
    },
    {
      "fieldname": "gross_weight_kg",
      "fieldtype": "Float",
      "label": "Gross Weight (kg)"
    },
    {
      "fieldname": "delivery_run",
      "fieldtype": "Link",
      "label": "Delivery Run",
      "options": "Delivery Run",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Outbound Shipment",
      "read_only": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {"role": "WMS Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "delete": 1},
    {"role": "WMS Packer", "read": 1, "write": 1, "submit": 1},
    {"role": "WMS Picker", "read": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1, "cancel": 1}
  ],
  "title_field": "name",
  "search_fields": "customer,sales_order,status,channel,tracking_number"
}
