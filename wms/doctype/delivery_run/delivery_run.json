{
  "name": "Delivery Run",
  "module": "WMS",
  "doctype": "DocType",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "WMS-DR-.#####",
  "description": "Last-mile delivery run / route plan. Groups outbound shipments for a single vehicle/rider. Models Zepto rider batching.",
  "fields": [
    {
      "fieldname": "run_date",
      "fieldtype": "Date",
      "label": "Run Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "vehicle",
      "fieldtype": "Data",
      "label": "Vehicle / Rider ID",
      "reqd": 1
    },
    {
      "fieldname": "driver",
      "fieldtype": "Link",
      "label": "Driver / Rider",
      "options": "User"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nLoading\nOut for Delivery\nCompleted\nPartial Delivery\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "departure_time",
      "fieldtype": "Datetime",
      "label": "Departure Time",
      "read_only": 1
    },
    {
      "fieldname": "return_time",
      "fieldtype": "Datetime",
      "label": "Return Time",
      "read_only": 1
    },
    {
      "fieldname": "section_break_shipments",
      "fieldtype": "Section Break",
      "label": "Shipments"
    },
    {
      "fieldname": "shipments",
      "fieldtype": "Table",
      "label": "Shipments",
      "options": "Delivery Run Shipment"
    },
    {
      "fieldname": "section_break_summary",
      "fieldtype": "Section Break",
      "label": "Run Summary"
    },
    {
      "fieldname": "total_shipments",
      "fieldtype": "Int",
      "label": "Total Shipments",
      "read_only": 1
    },
    {
      "fieldname": "delivered_count",
      "fieldtype": "Int",
      "label": "Delivered",
      "read_only": 1
    },
    {
      "fieldname": "failed_count",
      "fieldtype": "Int",
      "label": "Failed Deliveries",
      "read_only": 1
    }
  ],
  "permissions": [
    {"role": "WMS Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "delete": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1}
  ]
}
