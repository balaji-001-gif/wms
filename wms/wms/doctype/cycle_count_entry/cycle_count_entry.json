{
  "name": "Cycle Count Entry",
  "module": "wms",
  "doctype": "DocType",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "Expression",
  "autoname": "WMS-CC-.#####",
  "description": "Physical inventory verification – ABC-driven or zone-driven, with variance capture and stock reconciliation.",
  "fields": [
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Warehouse",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "zone",
      "fieldtype": "Link",
      "label": "Zone",
      "options": "Warehouse Zone"
    },
    {
      "fieldname": "count_type",
      "fieldtype": "Select",
      "label": "Count Type",
      "options": "Full Count\nABC A-Class\nABC B-Class\nABC C-Class\nZone-Specific\nSpot Check",
      "reqd": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nAssigned\nIn Progress\nPending Review\nReconciled\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_to",
      "fieldtype": "Link",
      "label": "Assigned To",
      "options": "User"
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Count Lines"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Items",
      "options": "Cycle Count Item"
    },
    {
      "fieldname": "section_break_variance",
      "fieldtype": "Section Break",
      "label": "Variance Summary"
    },
    {
      "fieldname": "total_lines",
      "fieldtype": "Int",
      "label": "Total Lines",
      "read_only": 1
    },
    {
      "fieldname": "variance_lines",
      "fieldtype": "Int",
      "label": "Variance Lines",
      "read_only": 1
    },
    {
      "fieldname": "variance_value",
      "fieldtype": "Currency",
      "label": "Total Variance Value",
      "read_only": 1
    },
    {
      "fieldname": "linked_stock_reconciliation",
      "fieldtype": "Link",
      "label": "Stock Reconciliation",
      "options": "Stock Reconciliation",
      "read_only": 1
    }
  ],
  "permissions": [
    {"role": "WMS Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "delete": 1},
    {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1, "cancel": 1}
  ],
  "title_field": "name"
}
